{
  "name": "cafe-pos-server",
  "version": "0.1.0",
  "private": true,
  "description": "Express API for the Cafe POS application.",
  "scripts": {
    "dev": "prisma generate --schema prisma/schema && tsx watch src/server.ts",
    "build": "prisma generate --schema prisma/schema && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "prisma generate --schema prisma/schema && tsc --noEmit",
    "test": "tsx --test src/app.test.ts",
    "db:validate": "prisma validate --schema prisma/schema",
    "db:generate": "prisma generate --schema prisma/schema",
    "db:migrate": "prisma migrate dev --schema prisma/schema",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema",
    "db:status": "prisma migrate status --schema prisma/schema",
    "db:seed": "prisma generate --schema prisma/schema && prisma db seed"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.1",
    "prisma": "7.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
