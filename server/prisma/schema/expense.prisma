model Expense {
    id          String   @id @default(uuid())
    description String
    category    String
    amountPaisa Int
    spentAt     DateTime
    note        String?
    createdById String
    createdAt   DateTime @default(now())

    createdBy Staff @relation(fields: [createdById], references: [id])

    @@index([spentAt, id])
    @@index([category, spentAt])
}
