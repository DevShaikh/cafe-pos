model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  pricePaisa  Int      @default(0)
  category    String?
  imageUrl    String?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]
}
