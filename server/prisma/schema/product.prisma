model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Int
  category    String
  imageUrl    String?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, isAvailable])
  @@map("products")
}
