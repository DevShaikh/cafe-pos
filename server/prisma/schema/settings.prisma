model Settings {
    id            String   @id @default("singleton")
    cafeName      String   @default("Cafe POS")
    currency      String   @default("PKR")
    taxEnabled    Boolean  @default(true)
    taxRateBps    Int      @default(800)
    receiptFooter String?  @default("Thank you for your visit!")
    receiptPrefix String   @default("R")
    updatedAt     DateTime @updatedAt
}
